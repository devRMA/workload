# Google Analytics
# Como obter:
# 1. Acesse https://analytics.google.com/
# 2. Crie uma conta/propriedade para o seu site.
# 3. Vá em "Administrador" (engrenagem inferior esquerda) > "Fluxos de dados" > Escolha o seu fluxo Web.
# 4. Copie o "ID DE MEDIÇÃO" (começa com "G-").
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Google Ads (AdSense)
# Como obter:
# 1. Acesse https://adsense.google.com/
# 2. Crie uma conta e adicione seu site na aba "Sites".
# 3. Vá em "Anúncios" > "Por bloco de anúncios" e crie um novo bloco "Display" (responsivo).
# 4. Copie o "data-ad-client" (começa com "ca-pub-") no campo abaixo.
NEXT_PUBLIC_ADSENSE_ID=ca-pub-XXXXXXXXXXXXXXXX
